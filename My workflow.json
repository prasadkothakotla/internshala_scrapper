        "jsCode": "// Pull all internships already in the sheet\nconst existingRows = $('Get rows in sheet').all();\nconst existingUrls = new Set(existingRows.map(r => r.json.url));\n\n// HTTP Request returns an array — get it regardless of how it's shaped\nconst scraped = $input.first().json; // adjust if your HTTP node already splits into items\nconst list = Array.isArray(scraped) ? scraped : items.map(i => i.json);\n\n// Keep only internships whose URL is NOT already in the sheet\nconst newOnes = list.filter(job => job.url && !existingUrls.has(job.url));\n\nreturn newOnes.map(job => ({ json: job }));"
